#!/bin/sh
# openhc-control4 on the box: /data/extensions/control4/init, started at boot
# by openHC's S96ohc-extensions. The on-screen navigator and the SDDP announcer.
#
# Runs control4-fake-navigator's backend: the openHC Controller driver connects
# to its sink (:9010) with the room's nav keys and a Director token, and it
# serves the UI to the box's own web view on :8090 (:8080 is the Wi-Fi setup
# portal's). `display` points openHC's on-screen view (S95ohc-display) at it.
#
# Also runs c4sddp, which announces the box over Control4's SDDP so Composer
# discovers it and fills in the driver's address, and the audio client
# (c4-audio-client), which Control4's Digital Media streams to: one zone per
# audio output openHC's audiod reports, each playing into that output's shared
# PCM (ohc_<id>, a dmix), so it mixes with AirPlay/Spotify and the navigator.
# c4zones rewrites its config from audiod's outputs every time it starts.
# Two more c4sddp identities announce the audio client to Control4's own
# drivers: the box's own model (c4:control4_ea3, ...: every output) and a
# Triad One (c4:triad_one: one output). Added in Composer, either is a real
# Digital Media endpoint, so every Control4 source (TuneIn,
# My Music, ShairBridge, ...) streams to the box with no per-source driver.
# (Director only hands streams to native drivers; a Lua driver can't report
# the client's address, see README.)
#
# Overrides (SINK_ADDR, HTTP_ADDR, C4_WALLPAPER, ...) in c4nav.conf next to this.
D=$(cd "$(dirname "$0")" && pwd)
PIDF=/run/c4nav.pid
SDDP_PIDF=/run/c4sddp.pid
AUDIO_PIDF=/run/c4audio.pid
AUDIO_SDDP_PIDF=/run/c4sddp-audio.pid
NATIVE_SDDP_PIDF=/run/c4sddp-native.pid
URL=http://localhost:8090/

export SINK_ADDR=0.0.0.0:9010 HTTP_ADDR=127.0.0.1:8090 WEB_DIR=$D/www
[ -r "$D/c4nav.conf" ] && { set -a; . "$D/c4nav.conf"; set +a; }

# The board: slug (its openhc-<slug>.c4z), model (shown in Composer) and,
# where it has digital audio, native (Control4's own driver for that model).
board() {
	[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
	# Some images don't set OHC_MODEL in board.env. iod knows the board, so
	# ask it (it serves the model string at /api/io) and wait for it at boot.
	if [ -z "$OHC_MODEL" ]; then
		i=0
		while [ $i -lt 30 ]; do
			board=$(wget -qO- http://127.0.0.1:7070/api/io 2>/dev/null \
				| sed -n 's/.*"board":"\([^"]*\)".*/\1/p')
			[ -n "$board" ] && break
			i=$((i + 1)); sleep 2
		done
		case "$board" in
			*EA-1*)   OHC_MODEL=1 ;;
			*EA-3*)   OHC_MODEL=3 ;;
			*EA-5*)   OHC_MODEL=5 ;;
			*HC-250*) OHC_MODEL=hc250 ;;
			*HC-800*) OHC_MODEL=hc800 ;;
			*CA-1*)   OHC_MODEL=ca1 ;;
			*IOX*|*I/O*) OHC_MODEL=ioxv1 ;;
		esac
	fi
	case "$OHC_MODEL" in
		1) slug=ea1; model="EA-1"; native="c4:control4_ea1 control4_ea1.c4i" ;;
		3) slug=ea3; model="EA-3"; native="c4:control4_ea3 control4_ea3.c4i" ;;
		5) slug=ea5; model="EA-5"; native="c4:control4_ea5 control4_ea5.c4i" ;;
		hc250) slug=hc250; model="HC-250" ;;
		hc800) slug=hc800; model="HC-800"; native="c4:control4_hc800_homecontroller control4_hc800.c4i" ;;
		ca1)   slug=ca1;   model="CA-1" ;;
		ioxv1) slug=iox;   model="IOX" ;;
		*)     slug="${OHC_MODEL:-device}"; model="${OHC_MODEL:-controller}" ;;
	esac
}

case "$1" in
	start)
		[ -x $D/bin/c4nav ] || exit 0
		start-stop-daemon -S -q -b -m -p $PIDF -x /bin/sh -- "$0" run
		start-stop-daemon -S -q -b -m -p $SDDP_PIDF -x /bin/sh -- "$0" sddp
		if [ ! -x $D/bin/c4-audio-client ]; then :
		elif ! ls /usr/lib/libgstreamer-1.0.so.* >/dev/null 2>&1; then
			logger -t c4audio "no GStreamer in this openHC image (the gstreamer feature): no audio client"
		else
			start-stop-daemon -S -q -b -m -p $AUDIO_PIDF -x /bin/sh -- "$0" audio
			start-stop-daemon -S -q -b -m -p $AUDIO_SDDP_PIDF -x /bin/sh -- "$0" sddp-audio
			start-stop-daemon -S -q -b -m -p $NATIVE_SDDP_PIDF -x /bin/sh -- "$0" sddp-native
		fi
		;;
	stop)
		for p in $PIDF $SDDP_PIDF $AUDIO_PIDF $AUDIO_SDDP_PIDF $NATIVE_SDDP_PIDF; do [ -f $p ] && start-stop-daemon -K -q -p $p; done
		killall -q c4nav c4sddp c4-audio-client 2>/dev/null
		rm -f $PIDF $SDDP_PIDF $AUDIO_PIDF $AUDIO_SDDP_PIDF $NATIVE_SDDP_PIDF
		;;
	restart)
		"$0" stop; sleep 1; "$0" start ;;
	run)
		# Restarted if it exits.
		while :; do $D/bin/c4nav 2>&1 | logger -t c4nav; sleep 3; done ;;
	sddp)
		# One SDDP Type per model (openhc:<slug>) matching that model's driver.
		board
		while :; do $D/bin/c4sddp "$slug" "openHC $model" 2>&1 | logger -t c4sddp; sleep 3; done ;;
	sddp-native)
		# The box as the Control4 controller it is: all its audio outputs, at the
		# ports that model's own driver uses.
		board
		[ -n "$native" ] || exit 0
		set -- $native
		while :; do $D/bin/c4sddp "$1" "openHC $model Audio" "$2" 2>&1 | logger -t c4sddp; sleep 3; done ;;
	sddp-audio)
		# And as a Triad One (one output, 6200), for Directors whose OS no longer
		# ships the older controllers' drivers.
		while :; do $D/bin/c4sddp c4:triad_one "openHC Audio" control4_tr1.c4i 2>&1 | logger -t c4sddp; sleep 3; done ;;
	audio)
		# c4zones: 0 = zones written, 3 = no named outputs on this board, else audiod not up.
		while :; do
			$D/bin/c4zones > $D/c4-audio-client.toml.new
			case $? in
				0) mv -f $D/c4-audio-client.toml.new $D/c4-audio-client.toml
				   $D/bin/c4-audio-client $D/c4-audio-client.toml 2>&1 | logger -t c4audio ;;
				3) logger -t c4audio "no named audio outputs on this board: no audio client"; exit 0 ;;
			esac
			sleep 5
		done ;;
	display)
		# The same config webd's POST /api/display writes, where S95ohc-display reads it.
		[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
		CONF="${OHC_DISPLAY_CONF:-/opt/ohc/display.conf}"
		printf '# written by openhc-control4\nOHC_DISPLAY_ENABLE=1\nOHC_DISPLAY_URL=%s\nOHC_DISPLAY_THEME=auto\n' "$URL" > "$CONF"
		[ -x /etc/init.d/S95ohc-display ] && /etc/init.d/S95ohc-display reload
		;;
	*)
		echo "Usage: $0 {start|stop|restart|display}"; exit 1 ;;
esac
