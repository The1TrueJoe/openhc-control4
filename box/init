#!/bin/sh
# openhc-control4 on the box: /data/extensions/control4/init, started at boot
# by openHC's S96ohc-extensions. The on-screen navigator and the SDDP announcer.
#
# Runs control4-fake-navigator's backend: the openHC Controller driver connects
# to its sink (:9010) with the room's nav keys and a Director token, and it
# serves the UI to the box's own web view on :8090 (:8080 is the Wi-Fi setup
# portal's). `display` points openHC's on-screen view (S95ohc-display) at it.
#
# Also runs c4sddp, which announces the box over Control4's SDDP so Composer
# discovers it and fills in the driver's address, and the audio client
# (c4-audio-client), which Control4's Digital Media streams to: one zone per
# audio output openHC's audiod reports, each playing into that output's shared
# PCM (ohc_<id>, a dmix), so it mixes with AirPlay/Spotify and the navigator.
# c4zones rewrites its config from audiod's outputs every time it starts.
# The openHC driver adds the box's audio as a second device run by Control4's
# own driver for the model (control4_ea3, ...) and points it at this box's IP,
# so every Control4 source (TuneIn, My Music, ShairBridge, ...) streams to the
# audio client with no per-source driver. (Director only streams to Control4's
# own drivers; a Lua driver can't report the client's address, see README.)
#
# Control4 Zigbee (experimental): `init zigbee control4` hands the box's EM357
# to c4zapd (control4-zigbee), which runs it on Control4's own EmberZNet 4.7.2
# as a Control4 Zigbee access point. `init zigbee openhc` gives it back to
# openHC's zigbee-bridge. The choice is kept in c4zapd's mode file
# (OHC_C4ZIGBEE_STATE, default /data/ohc/c4zigbee.mode) and in
# /data/ohc/zigbee.env (OHC_ZIGBEE_STACK=none keeps openHC off the radio), so
# it survives reboots and updates.
#
# Overrides (SINK_ADDR, HTTP_ADDR, C4_WALLPAPER, ...) in c4nav.conf next to this.
D=$(cd "$(dirname "$0")" && pwd)
PIDF=/run/c4nav.pid
SDDP_PIDF=/run/c4sddp.pid
AUDIO_PIDF=/run/c4audio.pid
ZAP_PIDF=/run/c4zapd.pid
ZIGBEE_ENV=/data/ohc/zigbee.env
URL=http://localhost:8090/

export SINK_ADDR=0.0.0.0:9010 HTTP_ADDR=127.0.0.1:8090 WEB_DIR=$D/www
[ -r "$D/c4nav.conf" ] && { set -a; . "$D/c4nav.conf"; set +a; }

# The board: slug (its openhc-<slug>.c4z) and model (shown in Composer).
board() {
	[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
	# Some images don't set OHC_MODEL in board.env. iod knows the board, so
	# ask it (it serves the model string at /api/io) and wait for it at boot.
	if [ -z "$OHC_MODEL" ]; then
		i=0
		while [ $i -lt 30 ]; do
			board=$(wget -qO- http://127.0.0.1:7070/api/io 2>/dev/null \
				| sed -n 's/.*"board":"\([^"]*\)".*/\1/p')
			[ -n "$board" ] && break
			i=$((i + 1)); sleep 2
		done
		case "$board" in
			*EA-1*)   OHC_MODEL=1 ;;
			*EA-3*)   OHC_MODEL=3 ;;
			*EA-5*)   OHC_MODEL=5 ;;
			*HC-250*) OHC_MODEL=hc250 ;;
			*HC-800*) OHC_MODEL=hc800 ;;
			*CA-1*)   OHC_MODEL=ca1 ;;
			*IOX*|*I/O*) OHC_MODEL=ioxv1 ;;
		esac
	fi
	case "$OHC_MODEL" in
		1) slug=ea1; model="EA-1" ;;
		3) slug=ea3; model="EA-3" ;;
		5) slug=ea5; model="EA-5" ;;
		hc250) slug=hc250; model="HC-250" ;;
		hc800) slug=hc800; model="HC-800" ;;
		ca1)   slug=ca1;   model="CA-1" ;;
		ioxv1) slug=iox;   model="IOX" ;;
		*)     slug="${OHC_MODEL:-device}"; model="${OHC_MODEL:-controller}" ;;
	esac
}

# c4zapd's mode file: control4 or standard.
zstate() {
	[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
	ZSTATE="${OHC_C4ZIGBEE_STATE:-/data/ohc/c4zigbee.mode}"
}

zap_start() {
	[ -x $D/bin/c4zapd ] && [ -e /dev/zigbee ] || return 0
	start-stop-daemon -S -q -b -m -p $ZAP_PIDF -x /bin/sh -- "$0" zap
}

zap_stop() {
	[ -f $ZAP_PIDF ] && start-stop-daemon -K -q -p $ZAP_PIDF
	killall -q c4zapd 2>/dev/null
	rm -f $ZAP_PIDF
}

case "$1" in
	start)
		[ -x $D/bin/c4nav ] || exit 0
		start-stop-daemon -S -q -b -m -p $PIDF -x /bin/sh -- "$0" run
		start-stop-daemon -S -q -b -m -p $SDDP_PIDF -x /bin/sh -- "$0" sddp
		if [ ! -x $D/bin/c4-audio-client ]; then :
		elif ! ls /usr/lib/libgstreamer-1.0.so.* >/dev/null 2>&1; then
			logger -t c4audio "no GStreamer in this openHC image (the gstreamer feature): no audio client"
		else
			start-stop-daemon -S -q -b -m -p $AUDIO_PIDF -x /bin/sh -- "$0" audio
		fi
		zstate
		[ "$(cat "$ZSTATE" 2>/dev/null)" = control4 ] && zap_start
		;;
	stop)
		for p in $PIDF $SDDP_PIDF $AUDIO_PIDF; do [ -f $p ] && start-stop-daemon -K -q -p $p; done
		killall -q c4nav c4sddp c4-audio-client 2>/dev/null
		rm -f $PIDF $SDDP_PIDF $AUDIO_PIDF
		zap_stop
		;;
	restart)
		"$0" stop; sleep 1; "$0" start ;;
	run)
		# Restarted if it exits.
		while :; do $D/bin/c4nav 2>&1 | logger -t c4nav; sleep 3; done ;;
	sddp)
		# One SDDP Type per model (openhc:<slug>) matching that model's driver.
		board
		while :; do $D/bin/c4sddp "$slug" "openHC $model" 2>&1 | logger -t c4sddp; sleep 3; done ;;
	audio)
		# c4zones: 0 = zones written, 3 = no named outputs on this board, else audiod not up.
		while :; do
			$D/bin/c4zones > $D/c4-audio-client.toml.new
			case $? in
				0) mv -f $D/c4-audio-client.toml.new $D/c4-audio-client.toml
				   $D/bin/c4-audio-client $D/c4-audio-client.toml 2>&1 | logger -t c4audio ;;
				3) logger -t c4audio "no named audio outputs on this board: no audio client"; exit 0 ;;
			esac
			sleep 5
		done ;;
	zap)
		# c4zapd: the Control4 Zigbee access point on the EM357. Restarted if it exits.
		zstate
		[ -r /opt/ohc/board.env ] && { set -a; . /opt/ohc/board.env; set +a; }
		export OHC_ZIGBEE_TTY=/dev/zigbee OHC_ZIGBEE_TOOL=/opt/ohc/bin/zigbee OHC_C4ZIGBEE_STATE="$ZSTATE"
		while :; do $D/bin/c4zapd 2>&1 | logger -t c4zapd; sleep 3; done ;;
	zigbee)
		# Who runs the Zigbee radio: control4 (c4zapd) or openhc (zigbee-bridge).
		[ -e /dev/zigbee ] || { echo "This board has no Zigbee radio."; exit 0; }
		zstate
		mkdir -p /data/ohc "$(dirname "$ZSTATE")"
		case "$2" in
			control4)
				[ -x $D/bin/c4zapd ] || { echo "c4zapd is not installed."; exit 1; }
				[ -x /etc/init.d/S92ohczigbee-bridge ] && /etc/init.d/S92ohczigbee-bridge stop
				[ -x /etc/init.d/S91ohczigbee ] && /etc/init.d/S91ohczigbee stop
				echo "Putting Control4's Zigbee firmware back on the radio..."
				if ! /opt/ohc/bin/zigbee --restore-stock; then
					echo "Could not restore Control4's firmware. Giving the radio back to openHC."
					[ -x /etc/init.d/S91ohczigbee ] && /etc/init.d/S91ohczigbee start
					[ -x /etc/init.d/S92ohczigbee-bridge ] && /etc/init.d/S92ohczigbee-bridge start
					exit 1
				fi
				[ -f $ZIGBEE_ENV ] && sed -i '/^OHC_ZIGBEE_STACK=/d' $ZIGBEE_ENV
				echo OHC_ZIGBEE_STACK=none >> $ZIGBEE_ENV
				echo control4 > "$ZSTATE"
				zap_start
				echo "Zigbee: Control4 (c4zapd)."
				;;
			openhc)
				zap_stop
				[ -f $ZIGBEE_ENV ] && sed -i '/^OHC_ZIGBEE_STACK=none$/d' $ZIGBEE_ENV
				echo standard > "$ZSTATE"
				# S91 flashes openHC's own firmware back on the radio.
				[ -x /etc/init.d/S91ohczigbee ] && /etc/init.d/S91ohczigbee start
				[ -x /etc/init.d/S92ohczigbee-bridge ] && /etc/init.d/S92ohczigbee-bridge start
				echo "Zigbee: openHC (zigbee-bridge)."
				;;
			*)
				echo "Zigbee: $(cat "$ZSTATE" 2>/dev/null || echo standard)"
				echo "Usage: $0 zigbee {control4|openhc}"; exit 1 ;;
		esac
		;;
	display)
		# The same config webd's POST /api/display writes, where S95ohc-display reads it.
		[ -r /opt/ohc/board.env ] && . /opt/ohc/board.env
		CONF="${OHC_DISPLAY_CONF:-/opt/ohc/display.conf}"
		printf '# written by openhc-control4\nOHC_DISPLAY_ENABLE=1\nOHC_DISPLAY_URL=%s\nOHC_DISPLAY_THEME=auto\n' "$URL" > "$CONF"
		[ -x /etc/init.d/S95ohc-display ] && /etc/init.d/S95ohc-display reload
		;;
	*)
		echo "Usage: $0 {start|stop|restart|display|zigbee control4|zigbee openhc}"; exit 1 ;;
esac
